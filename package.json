{
  "name": "liteeditor",
  "version": "1.0.0",
  "description": "Lightweight code editor built with Electron + Monaco",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "npx playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npx playwright test tests/e2e/",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.liteeditor.app",
    "productName": "LiteEditor",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/*/{test,tests,__tests__,docs,example,examples}/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown Document"
        },
        {
          "ext": [
            "txt",
            "log"
          ],
          "name": "Text",
          "description": "Text Document"
        },
        {
          "ext": [
            "json",
            "jsonc"
          ],
          "name": "JSON",
          "description": "JSON Document"
        },
        {
          "ext": [
            "js",
            "mjs",
            "cjs"
          ],
          "name": "JavaScript",
          "description": "JavaScript File"
        },
        {
          "ext": [
            "ts",
            "mts",
            "cts"
          ],
          "name": "TypeScript",
          "description": "TypeScript File"
        },
        {
          "ext": [
            "jsx",
            "tsx"
          ],
          "name": "React",
          "description": "React Component"
        },
        {
          "ext": [
            "html",
            "htm"
          ],
          "name": "HTML",
          "description": "HTML Document"
        },
        {
          "ext": [
            "css",
            "scss",
            "less"
          ],
          "name": "Stylesheet",
          "description": "Stylesheet"
        },
        {
          "ext": [
            "py"
          ],
          "name": "Python",
          "description": "Python File"
        },
        {
          "ext": [
            "yaml",
            "yml"
          ],
          "name": "YAML",
          "description": "YAML Document"
        },
        {
          "ext": [
            "xml",
            "svg"
          ],
          "name": "XML",
          "description": "XML Document"
        },
        {
          "ext": [
            "sh",
            "bash",
            "zsh"
          ],
          "name": "Shell",
          "description": "Shell Script"
        },
        {
          "ext": [
            "toml",
            "ini",
            "cfg",
            "conf"
          ],
          "name": "Config",
          "description": "Configuration File"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/simple-git/**/*",
      "node_modules/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "lite-ui": "file:../LiteCore/packages/lite-ui",
    "lucide-react": "^0.474.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "simple-git": "^3.27.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.2",
    "electron-builder": "^26.7.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  }
}
