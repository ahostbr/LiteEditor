{
  "name": "@liteeditor/desktop",
  "version": "0.0.13",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "bun run --parallel dev:bundle dev:electron",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "effect": "catalog:",
    "electron": "45.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@liteeditor/contracts": "workspace:*",
    "@liteeditor/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^9.5.1"
  },
  "productName": "LiteEditor"
}
